<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility: required to read Sketchware Pro's installed versionCode. -->
    <queries>
        <package android:name="pro.sketchware" />
        <package android:name="pro.sketchware.debug" />
        <package android:name="com.besome.sketch" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="SketchPilot"
        android:supportsRtl="true"
        android:theme="@style/Theme.SketchPilot">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="SketchPilot - AI-agent IDE bridge for Sketchware Pro" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:value="pro.sketchware" />

        <activity
            android:name=".ui.CapabilityActivity"
            android:exported="true"
            android:label="SketchPilot Capabilities" />

        <activity
            android:name=".ui.ComposeMainActivity"
            android:exported="true"
            android:label="SketchPilot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".mcp.KotlinMcpService"
            android:exported="false" />
    </application>
</manifest>
